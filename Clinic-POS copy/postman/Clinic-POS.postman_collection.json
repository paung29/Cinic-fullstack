              "raw": "{\n  \"adminPassword\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/clinics/{{clinicId}}/auth/elevate",
            "description": "Returns a clinical elevation token valid for 15 minutes."
          }
