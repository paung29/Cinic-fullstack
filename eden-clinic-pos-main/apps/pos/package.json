{
  "name": "eden-clinic-pos",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --env-file-if-exists=.env.local scripts/build-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "build:e2e": "NEXT_PUBLIC_EDEN_API_BASE_URL=http://127.0.0.1:4010 next build && NEXT_PUBLIC_EDEN_API_BASE_URL=http://127.0.0.1:4010 node scripts/build-pwa.mjs",
    "test:e2e": "npm run build:e2e && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "dexie": "4.4.4",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
