    {
      "name": "11 - Sales and Offline Sync",
      "item": [
        {
          "name": "Sync completed sale",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('clientSaleId')) {",
                  "  pm.collectionVariables.set('clientSaleId', pm.variables.replaceIn('{{$guid}}'));",
                  "}",
                  "if (!pm.collectionVariables.get('idempotencyKey')) {",
                  "  pm.collectionVariables.set('idempotencyKey', 'outbox-' + pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('saleId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{clientSaleId}}\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"saleNumber\": \"POS-{{clientSaleId}}\",\n  \"patient\": {\n    \"id\": \"{{patientId}}\",\n    \"name\": \"May Thu Updated\",\n    \"phone\": \"09222333444\",\n    \"allergies\": \"Penicillin\",\n    \"alertNote\": \"Confirm allergy before treatment\"\n  },\n  \"staffId\": \"{{staffId}}\",\n  \"followUpDate\": \"2026-08-15\",\n  \"createdOffline\": true,\n  \"createdAt\": \"{{$isoTimestamp}}\",\n  \"lines\": [\n    {\n      \"kind\": \"PRODUCT\",\n      \"catalogId\": \"{{productId}}\",\n      \"nameSnapshot\": \"Skin Serum 30ml\",\n      \"unitPrice\": 25.00,\n      \"quantity\": 1\n    }\n  ],\n  \"payments\": [\n    {\n      \"method\": \"CASH\",\n      \"amount\": 25.00,\n      \"referenceNumber\": null,\n      \"paidAt\": \"{{$isoTimestamp}}\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/clinics/{{clinicId}}/sync/sales",
            "description": "Run twice without clearing clientSaleId/idempotencyKey to verify idempotent replay. Clear those two collection variables before creating a different sale."
          }
        },
        {
          "name": "List sales",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/clinics/{{clinicId}}/sales"
          }
        },
        {
          "name": "Get sale",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/clinics/{{clinicId}}/sales/{{saleId}}"
          }
        },
        {
          "name": "Void sale",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/clinics/{{clinicId}}/sales/{{saleId}}/void?note=Customer%20refund"
          }
        }
      ]
