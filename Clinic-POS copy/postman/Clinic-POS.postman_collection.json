    {
      "name": "10 - Clinical Records",
      "item": [
        {
          "name": "Create clinical record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Elevation-Token",
                "value": "{{elevationToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": \"{{staffId}}\",\n  \"visitNotes\": \"Initial consultation completed\",\n  \"prescriptions\": \"Apply prescribed cream once daily\",\n  \"injectionMap\": \"{\\\"forehead\\\":[10,12,10]}\",\n  \"consents\": \"Treatment consent signed\",\n  \"mediaKeys\": \"patients/{{patientId}}/before-photo.jpg\",\n  \"contactLog\": \"Follow-up call requested\"\n}"
            },
            "url": "{{baseUrl}}/api/clinics/{{clinicId}}/patients/{{patientId}}/clinical-records"
          }
        },
        {
          "name": "List clinical records",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Elevation-Token",
                "value": "{{elevationToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/clinics/{{clinicId}}/patients/{{patientId}}/clinical-records"
          }
        }
      ]
